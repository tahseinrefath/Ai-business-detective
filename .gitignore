# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.coverage
htmlcov/

# Environment & secrets
.env
.env.*
!.env.example
*.pem

# Local data and generated files
uploads/*
!uploads/.gitkeep
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
reports/*
!reports/.gitkeep
logs/*
