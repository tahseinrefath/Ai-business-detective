# Copy to .env - never commit the real .env
# Leave SECRET_KEY empty and the app creates a random one in data/.secret_key (logins then survive restarts).
SECRET_KEY=
# Optional: PostgreSQL mirror of dataset metadata (app works without it)
DATABASE_URL=
# Optional: LLM explanation layer (app falls back to a rule-based explainer)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-6
# Decoupled frontend (Next.js / Netlify)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SECURE=False
