# Local Next.js dev rewrite target (used by web/next.config.mjs when NEXT_OUTPUT_EXPORT is not "true")
BACKEND_URL=http://127.0.0.1:5000

# Optional: leave blank when using Next.js rewrites (local) or Netlify proxy redirects (production).
# Only set if calling a separate backend domain directly without a proxy:
NEXT_PUBLIC_API_BASE_URL=
